{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"continue": false
		},
		{
			"src": "^/_diag/?(?:/__data.json)?$",
			"dest": "/_diag"
		},
		{
			"src": "^/_minimal/?(?:/__data.json)?$",
			"dest": "/_minimal"
		},
		{
			"src": "^/admin/generate-season-matchups/?(?:/__data.json)?$",
			"dest": "/admin/generate-season-matchups"
		},
		{
			"src": "^/honor-hall/?(?:/__data.json)?$",
			"dest": "/honor-hall"
		},
		{
			"src": "^/matchups/?(?:/__data.json)?$",
			"dest": "/matchups"
		},
		{
			"src": "^/records-player/?(?:/__data.json)?$",
			"dest": "/records-player"
		},
		{
			"src": "^/records-team/?(?:/__data.json)?$",
			"dest": "/records-team"
		},
		{
			"src": "^/rosters/?(?:/__data.json)?$",
			"dest": "/rosters"
		},
		{
			"src": "^/standings/?(?:/__data.json)?$",
			"dest": "/standings"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {
		"index.html": {
			"path": ""
		}
	}
}